<!DOCTYPE html>
<html lang="en">
<%- include("partials/head") %>

    <body class="min-h-screen bg-slate-950 text-cyan-600">
        <main class="mx-auto min-h-screen max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
            <header class="mb-10 flex items-end justify-between gap-6 border-b border-white/10 pb-6">
                <div>
                    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-cyan-600">TravelExp</p>
                    <h1 class="mt-3 text-4xl font-bold tracking-tight text-cyan-600 sm:text-5xl">Listings</h1>
                    <p class="mt-3 max-w-2xl text-sm leading-6 text-cyan-600 sm:text-base">
                        Homes submitted through the add-home form appear here as clean cards.
                    </p>
                </div>
            </header>

            <% if (homeArr && homeArr.length> 0) { %>
                <section class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
                    <% homeArr.forEach((home)=> { %>
                        <article
                            class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-lg shadow-black/20 backdrop-blur transition hover:-translate-y-1 hover:border-cyan-400/40 hover:bg-white/10">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-cyan-600">Home
                                    </p>
                                    <h2 class="mt-2 text-2xl font-semibold text-cyan-600">
                                        <%= home.houseName %>
                                    </h2>
                                </div>
                                <span
                                    class="rounded-full bg-cyan-400/15 px-3 py-1 text-xs font-semibold text-cyan-600">Listed</span>
                            </div>

                            <dl class="mt-6 space-y-4 text-sm text-cyan-600">
                                <div>
                                    <dt class="text-xs uppercase tracking-[0.2em] text-cyan-600">Address</dt>
                                    <dd class="mt-1 text-base text-cyan-600">
                                        <%= home.houseAddress %>
                                    </dd>
                                </div>

                                <div class="grid gap-4 sm:grid-cols-2">
                                    <div>
                                        <dt class="text-xs uppercase tracking-[0.2em] text-cyan-600">Contact</dt>
                                        <dd class="mt-1 text-base text-cyan-600">
                                            <%= home.houseContact %>
                                        </dd>
                                    </div>

                                    <div>
                                        <dt class="text-xs uppercase tracking-[0.2em] text-cyan-600">Email</dt>
                                        <dd class="mt-1 text-base text-cyan-600 wrap-break-word">
                                            <%= home.houseEmail %>
                                        </dd>
                                    </div>
                                </div>

                                <div>
                                    <dt class="text-xs uppercase tracking-[0.2em] text-cyan-600">Room Type</dt>
                                    <dd class="mt-1 text-base text-cyan-600">
                                        <%= home.homeSelect %>
                                    </dd>
                                </div>

                                <div>
                                    <dt class="text-xs uppercase tracking-[0.2em] text-cyan-600">Details</dt>
                                    <dd class="mt-1 text-base leading-6 text-cyan-600">
                                        <%= home.houseDetails %>
                                    </dd>
                                </div>
                            </dl>
                        </article>
                        <% }) %>
                </section>
                <% } else { %>
                    <section class="rounded-3xl border border-dashed border-white/15 bg-white/5 p-10 text-center">
                        <h2 class="text-2xl font-semibold text-cyan-600">No homes listed yet</h2>
                        <p class="mt-3 text-sm leading-6 text-cyan-600">Use the add-home form to create your first
                            listing.</p>
                    </section>
                    <% } %>
        </main>
    </body>

</html>